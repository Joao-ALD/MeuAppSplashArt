{
  "expo": {
    "name": "MeuAppSplashArt",
    "slug": "MeuAppSplashArt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon5.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
